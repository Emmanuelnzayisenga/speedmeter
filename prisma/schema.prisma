generator client {
  provider = "prisma-client-js"
  output   = "../src/app/generated/prisma"
    binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id                  String                                        @id

  username          String?               @map("username")     @db.VarChar(255)
  email               String                @map("email")        @db.VarChar(255)
  phoneNumber         String                @map("phone_number")     @db.VarChar(20)
  role                Role                  @map("role")            @default(DRIVER)
  isActive            Boolean               @map("is_active")       @default(false)
  lastLogin           DateTime?             @map("last_login")
  createdAt           DateTime              @map("created_at")      @default(now())
  updatedAt           DateTime              @map("updated_at")      @updatedAt
  password            String                                        @db.Text
  @@unique([username, email])

  vehicle             Vehicle?
  resetTokens         PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

enum Role {
  ADMIN
  DRIVER
}

model Vehicle {
  id           String    @id @default(cuid())
  name         String
  plateNumber  String    @unique
  type         VehicleType @default(CAR)
  status       VehicleStatus @default(INACTIVE)
  driverName   String?
  driverPhone  String?
  driverId     String?   @unique
  deviceId     String?   @unique
  color        String?   @default("#3B82F6")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  locations    VehicleLocation[]
  violations   Violation[]
  driverUser   User?     @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([deviceId])
  @@index([driverId])
}

model VehicleLocation {
  id          String   @id @default(cuid())
  vehicleId   String
  latitude    Float
  longitude   Float
  speed       Float    @default(0)
  heading     Float?
  altitude    Float?
  accuracy    Float?
  satellites  Int?
  timestamp   DateTime @default(now())

  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([timestamp])
  @@index([vehicleId, timestamp])
}


model pLocation {
  id          String   @id @default(cuid())
  vehicleId   String    @unique
  latitude    Float
  longitude   Float
  speed       Float    @default(0)
  

  @@index([vehicleId])
}

model SpeedZone {
  id           String   @id @default(cuid())
  name         String
  description  String?
  speedLimit   Float
  coordinates  Json      
  zoneType     ZoneType @default(POLYGON)
  color        String   @default("#EF4444")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  violations   Violation[]

  @@index([active])
}

model Violation {
  id          String          @id @default(cuid())
  vehicleId   String
  zoneId      String?
  latitude    Float
  longitude   Float
  speed       Float
  speedLimit  Float
  excessSpeed Float
  fineAmount  Float           @default(0)
  status      ViolationStatus @default(PENDING)
  notes       String?
  timestamp   DateTime        @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  zone        SpeedZone?      @relation(fields: [zoneId], references: [id])

  @@index([vehicleId])
  @@index([status])
  @@index([timestamp])
}

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

enum VehicleType {
  CAR
  TRUCK
  MOTORCYCLE
  BUS
  VAN
  OTHER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MOVING
  SPEEDING
  OFFLINE
}

enum ZoneType {
  POLYGON
  CIRCLE
  CORRIDOR
   ROAD 
}

enum ViolationStatus {
  PENDING
  CONFIRMED
  DISPUTED
  RESOLVED
  CANCELLED
}
